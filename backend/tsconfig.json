{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,

    "types": ["node"],

    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],

  "exclude": ["node_modules", "dist", "prisma.config.ts"]
}
