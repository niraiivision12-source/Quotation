generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                 @id @default(uuid())
  name              String
  email             String                 @unique
  password          String
  role              UserRole
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  assignedCustomers Customer[]
  leads             Lead[]
  leadActivities    LeadActivity[]
  leadNotes         LeadNote[]
  assignedProjects  Project[]
  projectActivities ProjectActivity[]
  assignedPhases    ProjectPhaseTracking[]
  quotations        Quotation[]
  reminders         Reminder[]
  assignedTasks     Task[]                 @relation("AssignedTasks")
  createdTasks      Task[]                 @relation("CreatedTasks")
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  userId    String?
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
}

model Product {
  id             String          @id @default(uuid())
  sku            String          @unique
  name           String
  brand          String?
  category       String?
  costPrice      Decimal         @db.Decimal(12, 2)
  stockQty       Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tallyStockQty  Int             @default(0)
  tallyUpdatedAt DateTime?
  unit           String?
  ProductMargin  ProductMargin[]
  quotationItems QuotationItem[]

  @@index([name])
  @@index([sku])
  @@index([category])
}

model ProductMargin {
  id            String    @id @default(uuid())
  productId     String
  role          UserRole?
  marginPercent Decimal   @db.Decimal(5, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Lead {
  id              String         @id @default(uuid())
  name            String
  mobile          String
  email           String?
  source          String?
  status          LeadStatus     @default(NEW)
  notes           String?
  assignedToId    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  convertedAt     DateTime?
  estimatedValue  Decimal?       @db.Decimal(12, 2)
  lastContactedAt DateTime?
  lostReason      String?
  nextFollowUpAt  DateTime?
  isActive        Boolean        @default(true)
  city            String?
  referralDate    DateTime?
  reopenedCount   Int            @default(0)
  customer        Customer?
  assignedTo      User?          @relation(fields: [assignedToId], references: [id])
  activities      LeadActivity[]
  notesHistory    LeadNote[]
  quotations      Quotation[]
  reminders       Reminder[]
  tasks           Task[]

  @@index([mobile])
  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}

model LeadActivity {
  id        String           @id @default(uuid())
  leadId    String
  userId    String?
  type      LeadActivityType
  message   String
  createdAt DateTime         @default(now())
  metadata  Json?
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([leadId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Customer {
  id           String             @id @default(uuid())
  name         String
  mobile       String             @unique
  email        String?
  address      String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  assignedToId String?
  city         String?
  notes        String?
  referralDate DateTime?
  source       String?
  leadId       String?            @unique
  assignedTo   User?              @relation(fields: [assignedToId], references: [id])
  lead         Lead?              @relation(fields: [leadId], references: [id])
  activities   CustomerActivity[]
  projects     Project[]
  quotations   Quotation[]
  reminders    Reminder[]
  tasks        Task[]

  @@index([assignedToId])
}

model CustomerActivity {
  id         String   @id @default(uuid())
  customerId String
  type       String
  message    String
  metadata   Json?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([createdAt])
}

model Project {
  id                 String                 @id @default(uuid())
  customerId         String
  projectName        String
  location           String?
  currentPhase       ProjectPhase           @default(PIPES)
  estimatedBudget    Decimal?               @db.Decimal(12, 2)
  startDate          DateTime?
  expectedCompletion DateTime?
  isCompleted        Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  assignedToId       String?
  isActive           Boolean                @default(true)
  assignedTo         User?                  @relation(fields: [assignedToId], references: [id])
  customer           Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  activities         ProjectActivity[]
  phaseTracking      ProjectPhaseTracking[]
  quotations         Quotation[]
  reminders          Reminder[]
  tasks              Task[]

  @@index([customerId])
  @@index([assignedToId])
  @@index([currentPhase])
}

model ProjectActivity {
  id        String   @id @default(uuid())
  projectId String
  userId    String?
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

model ProjectPhaseTracking {
  id             String          @id @default(uuid())
  projectId      String
  phase          ProjectPhase
  status         LifecycleStatus @default(NOT_STARTED)
  startedAt      DateTime?
  completedAt    DateTime?
  remarks        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  assignedToId   String?
  estimatedValue Decimal?        @db.Decimal(12, 2)
  assignedTo     User?           @relation(fields: [assignedToId], references: [id])
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, phase])
  @@index([projectId])
  @@index([phase])
  @@index([assignedToId])
}

model Reminder {
  id               String             @id @default(uuid())
  title            String
  description      String?
  type             ReminderType
  dueAt            DateTime
  completedAt      DateTime?
  status           ReminderStatus     @default(PENDING)
  userId           String
  leadId           String?
  customerId       String?
  projectId        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  notificationSent Boolean            @default(false)
  priority         ReminderPriority   @default(MEDIUM)
  repeatType       ReminderRepeatType @default(NONE)
  customer         Customer?          @relation(fields: [customerId], references: [id])
  lead             Lead?              @relation(fields: [leadId], references: [id])
  project          Project?           @relation(fields: [projectId], references: [id])
  user             User               @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([dueAt])
  @@index([notificationSent])
}

model Task {
  id           String       @id @default(uuid())
  title        String
  description  String?
  status       TaskStatus   @default(PENDING)
  priority     TaskPriority @default(MEDIUM)
  dueAt        DateTime?
  assignedToId String
  createdById  String
  leadId       String?
  customerId   String?
  projectId    String?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignedTo   User         @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy    User         @relation("CreatedTasks", fields: [createdById], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])

  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([dueAt])
}

model Quotation {
  id                          String                   @id @default(uuid())
  quotationNumber             String                   @unique
  type                        QuotationType            @default(LEAD)
  customerId                  String?
  projectId                   String?
  phase                       ProjectPhase?
  walkInName                  String?
  walkInMobile                String?
  walkInEmail                 String?
  walkInAddress               String?
  version                     Int                      @default(1)
  status                      QuotationStatus          @default(DRAFT)
  subtotal                    Decimal                  @db.Decimal(12, 2)
  discountAmount              Decimal                  @default(0) @db.Decimal(12, 2)
  totalAmount                 Decimal                  @db.Decimal(12, 2)
  notes                       String?
  validUntil                  DateTime?
  pdfUrl                      String?
  companyNameSnapshot         String?
  companyLogoSnapshot         String?
  companyGstSnapshot          String?
  companyAddressSnapshot      String?
  companyPhoneSnapshot        String?
  companyEmailSnapshot        String?
  companyWebsiteSnapshot      String?
  bankNameSnapshot            String?
  bankAccountNoSnapshot       String?
  bankIfscSnapshot            String?
  bankBranchSnapshot          String?
  upiIdSnapshot               String?
  termsAndConditionsSnapshot  String?
  authorizedSignatureSnapshot String?
  footerTextSnapshot          String?
  createdById                 String
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  approvedAt                  DateTime?
  parentQuotationId           String?
  rejectedAt                  DateTime?
  revisionReason              QuotationRevisionReason?
  leadId                      String?
  sentAt                      DateTime?
  createdBy                   User                     @relation(fields: [createdById], references: [id])
  customer                    Customer?                @relation(fields: [customerId], references: [id])
  lead                        Lead?                    @relation(fields: [leadId], references: [id])
  parentQuotation             Quotation?               @relation("QuotationVersions", fields: [parentQuotationId], references: [id])
  childVersions               Quotation[]              @relation("QuotationVersions")
  project                     Project?                 @relation(fields: [projectId], references: [id])
  items                       QuotationItem[]

  @@index([leadId])
  @@index([customerId])
  @@index([projectId])
  @@index([status])
  @@index([parentQuotationId])
}

model QuotationItem {
  id            String    @id @default(uuid())
  quotationId   String
  productId     String
  quantity      Int
  costPrice     Decimal   @db.Decimal(12, 2)
  marginPercent Decimal   @db.Decimal(5, 2)
  sellingPrice  Decimal   @db.Decimal(12, 2)
  totalPrice    Decimal   @db.Decimal(12, 2)
  product       Product   @relation(fields: [productId], references: [id])
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([productId])
}

model SystemSettings {
  id                           String   @id @default("default")
  companyName                  String   @default("")
  companyLogo                  String?
  companyGst                   String   @default("")
  companyAddress               String   @default("")
  companyPhone                 String   @default("")
  companyEmail                 String   @default("")
  companyWebsite               String   @default("")
  bankName                     String   @default("")
  bankAccountNo                String   @default("")
  bankIfsc                     String   @default("")
  bankBranch                   String   @default("")
  upiId                        String   @default("")
  termsAndConditions           String   @default("")
  authorizedSignature          String?
  footerText                   String   @default("")
  leadAssignmentMethod         String   @default("MANUAL")
  leadSalesmanPercentages      Json     @default("{}")
  lastLeadAssignedUserId       String?
  projectAssignmentMethod      String   @default("MANUAL")
  projectSalesmanPercentages   Json     @default("{}")
  projectPhaseAssignment       Json     @default("{}")
  quoteValidityDays            Int      @default(30)
  quoteDefaultNotes            String   @default("")
  quoteDefaultDiscount         Decimal  @default(0.00) @db.Decimal(5, 2)
  quoteCurrencySymbol          String   @default("₹")
  quoteNumberFormat            String   @default("QTN-{YYYY}-{NNN}")
  quoteTaxDisplay              String   @default("GST_BREAKUP")
  quotePdfHeaderFooter         Json     @default("{}")
  notificationReminderTime     String   @default("09:00")
  notificationReminderPriority String   @default("MEDIUM")
  notificationBrowserEnabled   Boolean  @default(true)
  notificationEmailEnabled     Boolean  @default(true)
  generalTimezone              String   @default("Asia/Kolkata")
  generalDateFormat            String   @default("DD/MM/YYYY")
  generalTheme                 String   @default("light")
  generalDefaultDashboard      String   @default("dashboard")
  rolePermissions              Json     @default("{}")
  pricingDefaultMargin         Decimal  @default(10.00) @db.Decimal(5, 2)
  pricingAllowMarginOverride   Boolean  @default(true)
  pricingMinMargin             Decimal  @default(0.00) @db.Decimal(5, 2)
  pricingMaxDiscount           Decimal  @default(100.00) @db.Decimal(5, 2)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

enum UserRole {
  OWNER
  SALESMAN
  ATTENDANT
  ACCOUNTANT
}

enum ProjectPhase {
  PIPES
  WIRING
  SWITCHES
  LIGHTS
  FANS
}

enum LifecycleStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  NOT_RESPONDING
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

enum ReminderStatus {
  PENDING
  COMPLETED
  MISSED
}

enum ReminderType {
  LEAD
  PROJECT
  CUSTOMER
  QUOTATION
  TASK
}

enum ReminderPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReminderRepeatType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

enum QuotationRevisionReason {
  PRICE_CHANGE
  PRODUCT_CHANGE
  CUSTOMER_REQUEST
  STOCK_CHANGE
  OTHER
}

enum QuotationType {
  LEAD
  CUSTOMER
  WALK_IN_CUSTOMER
}

enum LeadActivityType {
  CREATED
  STATUS_CHANGED
  FOLLOW_UP_SET
  FOLLOW_UP_COMPLETED
  NOTE_ADDED
  LOST
  REOPENED
  CONVERTED
  UPDATED
  REMINDER_CREATED
  QUOTATION_CREATED
  QUOTATION_SENT
  QUOTATION_APPROVED
  QUOTATION_REJECTED
  CONTACTED
  NEGOTIATION_STARTED
  REMINDER_COMPLETED
}
