generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                 @id @default(uuid())
  name                String
  email               String                 @unique
  password            String
  role                UserRole
  isActive            Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  assignedCustomers   Customer[]
  leads               Lead[]
  leadActivities      LeadActivity[]
  leadNotes           LeadNote[]
  assignedProjects    Project[]
  projectActivities   ProjectActivity[]
  assignedPhases      ProjectPhaseTracking[]
  quotations          Quotation[]
  reminders           Reminder[]
  assignedTasks       Task[]                 @relation("AssignedTasks")
  createdTasks        Task[]                 @relation("CreatedTasks")
  salesmanPayments    Payment[]              @relation("PaymentSalesman")
  accountantPayments  Payment[]              @relation("PaymentAccountant")
  collectorPayments   Payment[]              @relation("PaymentCollector")
  updatedTransactions PaymentTransaction[]   @relation("TransactionUpdatedBy")
  opportunities       Opportunity[]
  opportunityActivities OpportunityActivity[]
  purchaseOrders      PurchaseOrder[]
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  userId    String?
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
  @@index([createdAt])
}

model Product {
  id             String    @id @default(uuid())
  sku            String    @unique
  name           String
  brand          String?
  category       String?
  costPrice      Decimal?  @db.Decimal(12, 2)
  mrp            Decimal?  @db.Decimal(12, 2)
  stockQty       Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tallyStockQty  Int       @default(0)
  tallyUpdatedAt DateTime?
  unit           String?

  // Tally Sync Fields
  tallyMasterId String? @unique
  tallyGuid     String? @unique
  tallyAlterId  Int?
  stockGroupId  String?
  unitId        String?

  stockGroup StockGroup? @relation(fields: [stockGroupId], references: [tallyMasterId])
  tallyUnit  Unit?       @relation(fields: [unitId], references: [tallyMasterId])

  ProductMargin  ProductMargin[]
  quotationItems QuotationItem[]
  purchaseOrderItems PurchaseOrderItem[]
  searchable     Unsupported("tsvector")? @default(dbgenerated())

  @@index([name])
  @@index([sku])
  @@index([category])
}

model ProductMargin {
  id            String    @id @default(uuid())
  productId     String
  role          UserRole?
  marginPercent Decimal   @db.Decimal(5, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Lead {
  id              String         @id @default(uuid())
  name            String
  mobile          String
  email           String?
  source          String?
  status          LeadStatus     @default(NEW)
  notes           String?
  assignedToId    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  convertedAt     DateTime?
  estimatedValue  Decimal?       @db.Decimal(12, 2)
  lastContactedAt DateTime?
  lostReason      String?
  nextFollowUpAt  DateTime?
  isActive        Boolean        @default(true)
  city            String?
  referralDate    DateTime?
  reopenedCount   Int            @default(0)
  customer        Customer?
  assignedTo      User?          @relation(fields: [assignedToId], references: [id])
  activities      LeadActivity[]
  notesHistory    LeadNote[]
  quotations      Quotation[]
  reminders       Reminder[]
  tasks           Task[]

  @@index([mobile])
  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
}

model LeadActivity {
  id        String           @id @default(uuid())
  leadId    String
  userId    String?
  type      LeadActivityType
  message   String
  createdAt DateTime         @default(now())
  metadata  Json?
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([leadId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Customer {
  id                String             @id @default(uuid())
  name              String
  mobile            String             @unique
  email             String?
  address           String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  assignedToId      String?
  city              String?
  notes             String?
  referralDate      DateTime?
  source            String?
  leadId            String?            @unique
  assignedTo        User?              @relation(fields: [assignedToId], references: [id])
  lead              Lead?              @relation(fields: [leadId], references: [id])
  activities        CustomerActivity[]
  projects          Project[]
  quotations        Quotation[]
  reminders         Reminder[]
  tasks             Task[]
  creditAllowed     Boolean            @default(false)
  defaultCreditDays Int                @default(0)
  maxCreditAmount   Decimal            @default(0.00) @db.Decimal(12, 2)
  payments          Payment[]
  opportunities     Opportunity[]

  @@index([assignedToId])
}

model CustomerActivity {
  id         String   @id @default(uuid())
  customerId String
  type       String
  message    String
  metadata   Json?
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([createdAt])
}

model Project {
  id                 String                 @id @default(uuid())
  customerId         String
  projectName        String
  location           String?
  currentPhase       ProjectPhase           @default(PIPES)
  estimatedBudget    Decimal?               @db.Decimal(12, 2)
  startDate          DateTime?
  expectedCompletion DateTime?
  isCompleted        Boolean                @default(false)
  status             ProjectStatus          @default(ACTIVE)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  assignedToId       String?
  isActive           Boolean                @default(true)
  assignedTo         User?                  @relation(fields: [assignedToId], references: [id])
  customer           Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  activities         ProjectActivity[]
  phaseTracking      ProjectPhaseTracking[]
  quotations         Quotation[]
  reminders          Reminder[]
  tasks              Task[]
  payments           Payment[]

  @@index([customerId])
  @@index([assignedToId])
  @@index([currentPhase])
}

model ProjectActivity {
  id        String   @id @default(uuid())
  projectId String
  userId    String?
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

model ProjectPhaseTracking {
  id             String          @id @default(uuid())
  projectId      String
  phase          ProjectPhase
  status         LifecycleStatus @default(NOT_STARTED)
  startedAt      DateTime?
  completedAt    DateTime?
  remarks        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  assignedToId   String?
  estimatedValue Decimal?        @db.Decimal(12, 2)
  assignedTo     User?           @relation(fields: [assignedToId], references: [id])
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, phase])
  @@index([projectId])
  @@index([phase])
  @@index([assignedToId])
}

model Reminder {
  id               String             @id @default(uuid())
  title            String
  description      String?
  type             ReminderType
  dueAt            DateTime
  completedAt      DateTime?
  status           ReminderStatus     @default(PENDING)
  userId           String
  leadId           String?
  customerId       String?
  projectId        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  notificationSent Boolean            @default(false)
  priority         ReminderPriority   @default(MEDIUM)
  repeatType       ReminderRepeatType @default(NONE)
  customer         Customer?          @relation(fields: [customerId], references: [id])
  lead             Lead?              @relation(fields: [leadId], references: [id])
  project          Project?           @relation(fields: [projectId], references: [id])
  user             User               @relation(fields: [userId], references: [id])
  paymentId        String?
  payment          Payment?           @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  opportunityId    String?
  opportunity      Opportunity?       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([dueAt])
  @@index([notificationSent])
}

model Task {
  id           String       @id @default(uuid())
  title        String
  description  String?
  status       TaskStatus   @default(PENDING)
  priority     TaskPriority @default(MEDIUM)
  dueAt        DateTime?
  assignedToId String
  createdById  String
  leadId       String?
  customerId   String?
  projectId    String?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignedTo   User         @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy    User         @relation("CreatedTasks", fields: [createdById], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  paymentId    String?
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([dueAt])
  @@index([paymentId])
}

model Quotation {
  id                          String                   @id @default(uuid())
  quotationNumber             String                   @unique
  type                        QuotationType            @default(LEAD)
  customerId                  String?
  projectId                   String?
  phase                       ProjectPhase?
  walkInName                  String?
  walkInMobile                String?
  walkInEmail                 String?
  walkInAddress               String?
  version                     Int                      @default(1)
  status                      QuotationStatus          @default(DRAFT)
  subtotal                    Decimal                  @db.Decimal(12, 2)
  discountAmount              Decimal                  @default(0) @db.Decimal(12, 2)
  totalGst                    Decimal                  @default(0) @db.Decimal(12, 2)
  totalAmount                 Decimal                  @db.Decimal(12, 2)
  notes                       String?
  validUntil                  DateTime?
  pdfUrl                      String?
  companyNameSnapshot         String?
  companyLogoSnapshot         String?
  companyGstSnapshot          String?
  companyAddressSnapshot      String?
  companyPhoneSnapshot        String?
  companyEmailSnapshot        String?
  companyWebsiteSnapshot      String?
  bankNameSnapshot            String?
  bankAccountNoSnapshot       String?
  bankIfscSnapshot            String?
  bankBranchSnapshot          String?
  upiIdSnapshot               String?
  termsAndConditionsSnapshot  String?
  authorizedSignatureSnapshot String?
  footerTextSnapshot          String?
  createdById                 String
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  approvedAt                  DateTime?
  parentQuotationId           String?
  rejectedAt                  DateTime?
  revisionReason              QuotationRevisionReason?
  leadId                      String?
  sentAt                      DateTime?
  createdBy                   User                     @relation(fields: [createdById], references: [id])
  customer                    Customer?                @relation(fields: [customerId], references: [id])
  lead                        Lead?                    @relation(fields: [leadId], references: [id])
  parentQuotation             Quotation?               @relation("QuotationVersions", fields: [parentQuotationId], references: [id])
  childVersions               Quotation[]              @relation("QuotationVersions")
  project                     Project?                 @relation(fields: [projectId], references: [id])
  items                       QuotationItem[]
  billCreated                 Boolean                  @default(false)
  billNumber                  String?
  billDate                    DateTime?
  payment                     Payment?
  opportunityId               String?
  opportunity                 Opportunity?             @relation(fields: [opportunityId], references: [id])

  @@index([leadId])
  @@index([customerId])
  @@index([projectId])
  @@index([status])
  @@index([parentQuotationId])
}

model QuotationItem {
  id              String    @id @default(uuid())
  quotationId     String
  productId       String
  quantity        Int
  costPrice       Decimal?  @db.Decimal(12, 2)
  marginPercent   Decimal?  @db.Decimal(5, 2)
  mrp             Decimal?  @db.Decimal(12, 2)
  discountPercent Decimal?  @db.Decimal(5, 2)
  gstPercent      Decimal   @default(18.00) @db.Decimal(5, 2)
  sellingPrice    Decimal   @db.Decimal(12, 2)
  totalPrice      Decimal   @db.Decimal(12, 2)
  product       Product   @relation(fields: [productId], references: [id])
  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([productId])
}

model SystemSettings {
  id                             String   @id @default("default")
  companyName                    String   @default("")
  companyLogo                    String?
  companyGst                     String   @default("")
  companyAddress                 String   @default("")
  companyPhone                   String   @default("")
  companyEmail                   String   @default("")
  companyWebsite                 String   @default("")
  bankName                       String   @default("")
  bankAccountNo                  String   @default("")
  bankIfsc                       String   @default("")
  bankBranch                     String   @default("")
  upiId                          String   @default("")
  termsAndConditions             String   @default("")
  authorizedSignature            String?
  footerText                     String   @default("")
  leadAssignmentMethod           String   @default("MANUAL")
  leadSalesmanPercentages        Json     @default("{}")
  lastLeadAssignedUserId         String?
  projectAssignmentMethod        String   @default("MANUAL")
  projectSalesmanPercentages     Json     @default("{}")
  projectPhaseAssignment         Json     @default("{}")
  quoteValidityDays              Int      @default(30)
  quoteDefaultNotes              String   @default("")
  quoteDefaultDiscount           Decimal  @default(0.00) @db.Decimal(5, 2)
  quoteCurrencySymbol            String   @default("₹")
  quoteNumberFormat              String   @default("QTN-{YYYY}-{NNN}")
  quoteTaxDisplay                String   @default("GST_BREAKUP")
  quotePdfHeaderFooter           Json     @default("{}")
  notificationReminderTime       String   @default("09:00")
  notificationReminderPriority   String   @default("MEDIUM")
  notificationBrowserEnabled     Boolean  @default(true)
  notificationEmailEnabled       Boolean  @default(true)
  generalTimezone                String   @default("Asia/Kolkata")
  generalDateFormat              String   @default("DD/MM/YYYY")
  generalTheme                   String   @default("light")
  generalDefaultDashboard        String   @default("dashboard")
  rolePermissions                Json     @default("{}")
  pricingDefaultMargin           Decimal  @default(10.00) @db.Decimal(5, 2)
  pricingAllowMarginOverride     Boolean  @default(true)
  pricingMinMargin               Decimal  @default(0.00) @db.Decimal(5, 2)
  pricingMaxDiscount             Decimal  @default(100.00) @db.Decimal(5, 2)
  paymentAssignmentMethod        String   @default("PERCENTAGE")
  paymentAssignmentPercentages   Json     @default("{}")
  paymentDefaultCreditDays       Int      @default(30)
  paymentDefaultReminderSchedule Json     @default("[0]")
  paymentReminderFrequency       String   @default("DAILY")
  paymentOverdueGracePeriod      Int      @default(0)
  paymentDefaultMethods          Json     @default("[\"CASH\",\"BANK_TRANSFER\",\"UPI\",\"CHEQUE\"]")
  categorySalesmanAssignment     Json     @default("{}")
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

enum UserRole {
  OWNER
  SALESMAN
  ATTENDANT
  ACCOUNTANT
}

enum ProjectPhase {
  PIPES
  WIRING
  SWITCHES
  LIGHTS
  FANS
  OTHERS
}

enum LifecycleStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum LeadStatus {
  NEW
  CONTACTED
  NOT_RESPONDING
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

enum ReminderStatus {
  PENDING
  COMPLETED
  MISSED
  CANCELLED
}

enum ReminderType {
  LEAD
  PROJECT
  CUSTOMER
  QUOTATION
  TASK
  PAYMENT
  OPPORTUNITY
}

enum ReminderPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReminderRepeatType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

enum QuotationRevisionReason {
  PRICE_CHANGE
  PRODUCT_CHANGE
  CUSTOMER_REQUEST
  STOCK_CHANGE
  OTHER
}

enum QuotationType {
  LEAD
  CUSTOMER
  WALK_IN_CUSTOMER
  PURCHASE_ORDER
}

enum LeadActivityType {
  CREATED
  STATUS_CHANGED
  FOLLOW_UP_SET
  FOLLOW_UP_COMPLETED
  NOTE_ADDED
  LOST
  REOPENED
  CONVERTED
  UPDATED
  REMINDER_CREATED
  QUOTATION_CREATED
  QUOTATION_SENT
  QUOTATION_APPROVED
  QUOTATION_REJECTED
  CONTACTED
  NEGOTIATION_STARTED
  REMINDER_COMPLETED
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CLOSED_WITH_SALE
  CLOSED_WITHOUT_SALE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  FULLY_PAID
  OVERDUE
  CANCELLED
}

model Payment {
  id              String        @id @default(uuid())
  customerId      String
  projectId       String?
  quotationId     String        @unique
  salesmanId      String
  accountantId    String?
  collectorId     String
  billNumber      String
  billDate        DateTime
  totalBillAmount Decimal       @db.Decimal(12, 2)
  amountReceived  Decimal       @default(0.00) @db.Decimal(12, 2)
  pendingAmount   Decimal       @db.Decimal(12, 2)
  status          PaymentStatus @default(PENDING)
  dueDate         DateTime
  creditPeriod    Int           @default(0)
  remarks         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project      Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quotation    Quotation            @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  salesman     User                 @relation("PaymentSalesman", fields: [salesmanId], references: [id])
  accountant   User?                @relation("PaymentAccountant", fields: [accountantId], references: [id])
  collector    User                 @relation("PaymentCollector", fields: [collectorId], references: [id])
  transactions PaymentTransaction[]
  reminders    Reminder[]
  tasks        Task[]
  opportunityId String?
  opportunity  Opportunity?          @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([projectId])
  @@index([quotationId])
  @@index([salesmanId])
  @@index([collectorId])
  @@index([status])
}

model PaymentTransaction {
  id              String   @id @default(uuid())
  paymentId       String
  date            DateTime @default(now())
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethod   String
  referenceNumber String?
  notes           String?
  updatedById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  updatedBy User    @relation("TransactionUpdatedBy", fields: [updatedById], references: [id])

  @@index([paymentId])
  @@index([updatedById])
}

model StockGroup {
  id            String   @id @default(uuid())
  tallyMasterId String   @unique
  tallyGuid     String?  @unique
  tallyAlterId  Int?
  name          String
  parentName    String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products Product[]
}

model Unit {
  id            String   @id @default(uuid())
  tallyMasterId String   @unique
  tallyGuid     String?  @unique
  tallyAlterId  Int?
  name          String
  symbol        String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products Product[]
}

enum ProductCategory {
  PIPES
  WIRES
  SWITCHES
  LIGHTS
  FANS
  OTHERS
}

enum EnquiryStatus {
  PENDING
  TRIAGED
  IGNORED
}

enum OpportunityStatus {
  NEW
  CONTACTED
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

model Enquiry {
  id        String          @id @default(uuid())
  name      String
  mobile    String
  email     String?
  source    String          // "WHATSAPP", "WEBSITE", "WALK_IN", "PHONE", "MANUAL"
  message   String?
  status    EnquiryStatus   @default(PENDING)
  category  ProductCategory?
  city      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([mobile])
  @@index([status])
  @@index([createdAt])
}

model Opportunity {
  id             String            @id @default(uuid())
  customerId     String
  category       ProductCategory
  status         OpportunityStatus @default(NEW)
  assignedToId   String?
  estimatedValue Decimal?          @db.Decimal(12, 2)
  source         String?
  lostReason     String?
  nextFollowUpAt DateTime?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo   User?                @relation(fields: [assignedToId], references: [id])
  quotations   Quotation[]
  reminders    Reminder[]
  tasks        Task[]
  payments     Payment[]
  activities   OpportunityActivity[]

  @@index([customerId])
  @@index([status])
  @@index([category])
  @@index([assignedToId])
  @@index([createdAt])
}

model OpportunityActivity {
  id            String      @id @default(uuid())
  opportunityId String
  userId        String?
  type          String
  message       String
  metadata      Json?
  createdAt     DateTime    @default(now())

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id])

  @@index([opportunityId])
  @@index([userId])
  @@index([createdAt])
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  SENT
  ACKNOWLEDGED
  PARTIALLY_FULFILLED
  COMPLETED
  CANCELLED
  APPROVED
  REJECTED
}

model Dealer {
  id             String          @id @default(uuid())
  name           String
  contactPerson  String?
  mobile         String          @unique
  email          String?
  gst            String?
  address        String?
  city           String?
  state          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@index([mobile])
}

model PurchaseOrder {
  id                    String              @id @default(uuid())
  poNumber              String              @unique
  dealerId              String
  poDate                DateTime            @default(now())
  expectedDeliveryDate  DateTime?
  deliveryAddress       String?
  notes                 String?
  status                PurchaseOrderStatus @default(DRAFT)
  version               Int                 @default(1)
  parentPurchaseOrderId String?
  createdById           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  dealer                Dealer              @relation(fields: [dealerId], references: [id])
  createdBy             User                @relation(fields: [createdById], references: [id])
  parentPurchaseOrder   PurchaseOrder?      @relation("PurchaseOrderVersions", fields: [parentPurchaseOrderId], references: [id])
  childVersions         PurchaseOrder[]     @relation("PurchaseOrderVersions")
  items                 PurchaseOrderItem[]

  // Snapshots of Dealer details at the time of creation for historical records
  dealerNameSnapshot          String
  dealerContactPersonSnapshot String?
  dealerMobileSnapshot        String
  dealerEmailSnapshot         String?
  dealerAddressSnapshot       String?
  dealerGstSnapshot           String?

  // Snapshots of Company/Shop Info (optional, to align with quotation design)
  companyNameSnapshot         String?
  companyLogoSnapshot         String?
  companyGstSnapshot          String?
  companyAddressSnapshot      String?
  companyPhoneSnapshot        String?
  companyEmailSnapshot        String?
  companyWebsiteSnapshot      String?
  authorizedSignatureSnapshot String?

  @@index([dealerId])
  @@index([status])
  @@index([parentPurchaseOrderId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  productId       String
  quantity        Int

  product         Product       @relation(fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([productId])
}

