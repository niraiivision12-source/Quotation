// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  SALESMAN
  ATTENDANT
  ACCOUNTANT
}

enum ProjectPhase {
  PIPES
  WIRING
  SWITCHES
  LIGHTS
  FANS
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

enum ReminderStatus {
  PENDING
  COMPLETED
  MISSED
}

enum ReminderType {
  LEAD
  PROJECT
  CUSTOMER
  QUOTATION
  TASK
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String
  role     UserRole

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedCustomers Customer[]
  assignedProjects  Project[]
  leads Lead[]

  reminders Reminder[]
}

model Product {
  id String @id @default(uuid())

  sku  String @unique
  name String

  brand    String?
  category String?

  costPrice Decimal @db.Decimal(12, 2)

  stockQty Int @default(0)

  isActive Boolean @default(true)

  lastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id String @id @default(uuid())

  name   String
  mobile String
  email  String?

  address String?

  assignedToId String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedTo User? @relation(fields: [assignedToId], references: [id])

  projects Project[]
  reminders Reminder[]

  @@index([assignedToId])
}

model Project {
  id String @id @default(uuid())

  customerId   String
  assignedToId String?

  projectName String

  location String?

  currentPhase ProjectPhase @default(PIPES)

  estimatedBudget Decimal? @db.Decimal(12, 2)

  startDate DateTime?

  expectedCompletion DateTime?

  isCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  assignedTo User? @relation(fields: [assignedToId], references: [id])

  reminders Reminder[]

  @@index([customerId])
  @@index([assignedToId])
  @@index([currentPhase])
}

model Lead {
  id                    String      @id @default(uuid())

  name                  String
  mobile                String
  email                 String?

  source                String?

  status                LeadStatus  @default(NEW)

  estimatedValue        Decimal?    @db.Decimal(12,2)

  notes                 String?

  nextFollowUpAt        DateTime?

  lastContactedAt       DateTime?

  convertedAt           DateTime?

  lostReason            String?

  assignedToId          String?

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  assignedTo            User?       @relation(fields: [assignedToId], references: [id])

  reminders Reminder[]

  @@index([mobile])
  @@index([status])
  @@index([assignedToId])
  @@index([nextFollowUpAt])
}

model Reminder {
  id                String           @id @default(uuid())

  title             String
  description       String?

  type              ReminderType

  dueAt             DateTime

  completedAt       DateTime?

  status            ReminderStatus   @default(PENDING)

  userId            String

  leadId            String?

  customerId        String?

  projectId         String?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user              User             @relation(fields: [userId], references: [id])

  lead              Lead?            @relation(fields: [leadId], references: [id])

  customer          Customer?        @relation(fields: [customerId], references: [id])

  project           Project?         @relation(fields: [projectId], references: [id])

  @@index([userId])
  @@index([dueAt])
  @@index([status])
}